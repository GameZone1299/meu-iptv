function extractYear(name){const m=name.match(/\b(19\d{2}|20[0-2]\d)\b/);return m?parseInt(m[1]):null}
function detectQuality(name){
  const n=name.toUpperCase();
  if(/\b(4K|UHD|2160P)\b/.test(n))return["4K"];
  if(/\b(FHD|1920|1080P)\b/.test(n))return["FHD","HD"];
  if(/\b(HD|720P)\b/.test(n))return["HD"];
  if(/\b(SD|480P|360P)\b/.test(n))return["SD"];
  return["SD","HD"];
}
let ts=null;
function cleanup(){if(hls){hls.destroy();hls=null}if(ts){try{ts.destroy()}catch(e){}ts=null}
  /* devolve o fetch do Capacitor (usado só para carregar listas) */
  if(window._pf){window.fetch=window._pf;window._pf=null}}
async function play(it){
  const v=$("#v");$("#ph").classList.add("hide");$("#pvt").textContent=it.name;$("#pvh").textContent=it.group;
  const live=it.t==="live";
  $("#pvbox").classList.toggle("isLive",live);
  $("#ctrlLive").classList.toggle("on",live);
  $("#progressFill").style.width="0";$("#progressThumb").style.left="0";$("#progressBuf").style.width="0";
  $("#qualitySelect").innerHTML='<option value="auto">Auto</option>';
  $("#qualitySelect").disabled=true;
  let url=it.url;
  if(it.ia){$("#pvh").textContent="Carregando...";try{url=await iaUrl(it.ia)}catch(e){$("#ph").classList.remove("hide");$("#ph").textContent="Este título não tem vídeo compatível.";return}$("#pvh").textContent=it.group}
  clearInterval(window._wd);cleanup();

  /* Lembrar posição para VOD */
  let savedPos=0;
  if(settings.rememberPosition&&it.t!=="live"){
    try{const pos=JSON.parse(localStorage.getItem("iptv_positions")||"{}");if(pos[it.url])savedPos=pos[it.url]}catch(e){}
  }

  /* Salvar posição periodicamente */
  if(settings.rememberPosition&&it.t!=="live"){
    clearInterval(window._posInterval);
    window._posInterval=setInterval(()=>{
      if(v.currentTime>5&&v.duration-v.currentTime>10){
        try{
          const pos=getPositions();
          it.dur=v.duration||0;
          pos[it.url]=v.currentTime;
          try{localStorage.setItem("iptv_durs",JSON.stringify({...JSON.parse(localStorage.getItem("iptv_durs")||"{}"),[it.url]:v.duration||0}))}catch(e){}
          localStorage.setItem("iptv_positions",JSON.stringify(pos));
        }catch(e){}
      }
    },10000);
    v.onended=()=>{
      clearInterval(window._posInterval);
      try{
        const pos=JSON.parse(localStorage.getItem("iptv_positions")||"{}");
        delete pos[it.url];
        localStorage.setItem("iptv_positions",JSON.stringify(pos));
      }catch(e){}
    };
  }
  const isFile=/\.(mp4|mkv|webm|ogv|mov|m4v|mp3|aac)(\?|$)/i.test(url),isTs=/\.ts(\?|$)/i.test(url),isHls=/\.m3u8(\?|$)/i.test(url);
  let lastDet="";
  const fail=(info)=>{
    const er=v.error,ext=((url.split("?")[0].match(/\.([a-z0-9]{2,5})$/i)||[])[1]||"?").toLowerCase();
    if(typeof info==="string"&&info)lastDet=info;
    const det=lastDet;
    let dbg="";try{dbg=" [mpegts:"+(window.mpegts?"ok":"ausente")+", MSE:"+(window.mpegts&&mpegts.getFeatureList().mseLivePlayback?"sim":"não")+", hls:"+(window.Hls?"ok":"ausente")+"]"}catch(e){}
    const why=/403|401|forbidden/i.test(det)?"o servidor recusou o acesso (login, limite de conexões ou bloqueio)":/404|410/.test(det)?"este canal não existe mais no servidor":/HttpStatusCodeInvalid/i.test(det)?"o servidor respondeu com erro (canal fora do ar ou limite de telas)":/Network|Timeout|Connect/i.test(det)?"falha de rede ou bloqueio do servidor":/Codec|Media|Format|Unsupported/i.test(det)||(er&&(er.code===4||er.code===3))?"o formato/codec (por exemplo H.265) não é aceito pelo player":er&&er.code===2?"falha de rede ou o servidor recusou o acesso":"o servidor bloqueou o acesso ou o link expirou";
    $("#ph").classList.remove("hide");
    $("#ph").textContent="Não foi possível abrir este item.\nMotivo provável: "+why+".\n(formato: "+ext+(er?", código "+er.code:"")+(det?", detalhe: "+det:"")+")"+dbg};
  const startTs=()=>{
    if(!(window.mpegts&&mpegts.getFeatureList().mseLivePlayback))return false;
    /* No app Android o fetch é interceptado e não faz streaming; usa o original do navegador */
    if(window.CapacitorWebFetch&&!window._pf){window._pf=window.fetch;window.fetch=window.CapacitorWebFetch}
    ts=mpegts.createPlayer({type:"mpegts",isLive:true,url},{
      enableWorker:false,
      lazyLoad:false,
      liveBufferLatencyChasing:false,
      stashInitialSize:128*1024,
      autoCleanupSourceBuffer:true,
      autoCleanupMaxBackwardDuration:60,
      autoCleanupMinBackwardDuration:20
    });
    ts.attachMediaElement(v);ts.on(mpegts.Events.ERROR,(t,d,i)=>fail(t+" / "+d+(i&&i.code?" / "+i.code:"")+(i&&i.msg?" / "+i.msg:"")));ts.load();return true;
  };
  v.onerror=fail;
  if(isTs&&startTs()){}
  else if((isHls||(!isFile&&!isTs))&&window.Hls&&Hls.isSupported()){
    const hlsConfig={
      enableWorker:false,
      lowLatencyMode:false,
      backBufferLength:90,
      maxBufferLength:60,
      maxMaxBufferLength:120,
      manifestLoadingTimeOut:20000,
      manifestLoadingMaxRetry:3,
      levelLoadingTimeOut:20000,
      fragLoadingTimeOut:20000,
      liveSyncDurationCount:3,
      liveMaxLatencyDurationCount:10
    };
    if(settings.userAgent)hlsConfig.xhrSetup=function(xhr){xhr.setRequestHeader('User-Agent',settings.userAgent);
      if(settings.referer)xhr.setRequestHeader('Referer',settings.referer);
      if(settings.headers){settings.headers.split('\n').forEach(h=>{const[k,v]=h.split(':');if(k&&v)xhr.setRequestHeader(k.trim(),v.trim())})}};
    hls=new Hls(hlsConfig);hls.loadSource(url);hls.attachMedia(v);
    /* Seletor de qualidade a partir dos níveis HLS disponíveis */
    hls.on(Hls.Events.MANIFEST_PARSED,(_,d)=>{
      const lv=(d.levels||[]).filter(l=>l.height>0).sort((a,b)=>b.height-a.height);
      if(lv.length<2)return;
      const sel=$("#qualitySelect");
      sel.innerHTML='<option value="auto">Auto</option>'+lv.map(l=>`<option value="${l.height}">${l.height>=2160?"4K":l.height+"p"}</option>`).join("");
      sel.disabled=false;
      sel.onchange=()=>{
        if(!hls)return;
        if(sel.value==="auto")hls.currentLevel=-1;
        else{const i=hls.levels.findIndex(l=>l.height===parseInt(sel.value));if(i>=0)hls.currentLevel=i}
      };
    });
    hls.on(Hls.Events.ERROR,(_,d)=>{if(!d.fatal)return;const det="HLS "+d.details+(d.response&&d.response.code?" / "+d.response.code:"");hls.destroy();hls=null;if(!startTs()){v.src=url;v.play().catch(()=>{});v.onerror=()=>fail(det)}});
  }else v.src=url;
  v.play().catch(()=>{});

  /* Restaurar posição salva */
  if(savedPos>0){
    v.onloadedmetadata=()=>{
      v.currentTime=savedPos;
      v.onloadedmetadata=null;
    };
  }

  /* Reconexão automática configurável */
  clearInterval(window._wd);
  if(settings.autoReconnect&&(isTs||isHls||!isFile)){let last=-1,still=0;const checks=Math.ceil(settings.reconnectInterval/1.5);
    window._wd=setInterval(()=>{if(v.paused||!(ts||hls))return;
      if(v.currentTime===last){if(++still>=checks){clearInterval(window._wd);play(it)}}else{last=v.currentTime;still=0}},1500)}

  /* Registrar estatísticas */
  viewStats[it.url]=(viewStats[it.url]||0)+1;
