  localStorage.clear();location.reload();
};

/* Controle remoto / teclado */
function nav(dir){
  const root=$("#cfg").classList.contains("hide")?document:$("#cfg");
  const els=[...root.querySelectorAll('button,input,textarea,[tabindex="0"]')].filter(x=>x.getClientRects().length&&!x.disabled);
  const cur=document.activeElement;
  if(!els.includes(cur)){els[0]&&els[0].focus();return}
  const r=cur.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;let best=null,bs=1e9;
  for(const el of els){if(el===cur||cur.contains(el)||el.contains(cur))continue;
    const b=el.getBoundingClientRect(),dx=b.left+b.width/2-cx,dy=b.top+b.height/2-cy;
    const [p,o]=dir==="r"?[dx,dy]:dir==="l"?[-dx,dy]:dir==="d"?[dy,dx]:[-dy,dx];
    if(p<=4)continue;const s=p+2.5*Math.abs(o);if(s<bs){bs=s;best=el}}
  if(best){best.focus();best.scrollIntoView({block:"nearest",inline:"nearest"})}
}
document.addEventListener("keydown",e=>{
  const tg=e.target,typing=/INPUT|TEXTAREA/.test(tg.tagName);
  if(e.key==="Escape"||e.key==="Backspace"||e.keyCode===461){
    if(!$("#multi").classList.contains("hide")){e.preventDefault();closeMulti();return}
    if(document.body.classList.contains("cinema")){e.preventDefault();toggleCinema(false);return}
    if($("#pvbox").classList.contains("full")){e.preventDefault();setFull(false);return}
    if(!$("#cfg").classList.contains("hide")){e.preventDefault();$("#cfg").classList.add("hide");return}
    if(!typing&&scr!=="home"){e.preventDefault();$("#q").value="";goto("home");return}
  }
  if(e.key==="Enter"&&tg.tagName==="DIV"&&tg.hasAttribute("tabindex")){e.preventDefault();tg.click();return}
  const d={ArrowRight:"r",ArrowLeft:"l",ArrowDown:"d",ArrowUp:"u"}[e.key];if(!d)return;
  if(tg.tagName==="TEXTAREA"||(tg.tagName==="INPUT"&&(d==="l"||d==="r")))return;
  e.preventDefault();nav(d);
});
function renderFiles(){
  const out=[];
  for(const t of["live","movies","series"])files[t].forEach((f,i)=>out.push(`<div style="display:flex;gap:8px;align-items:center"><span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(T[t])}: ${esc(f.name)}</span><button class="rmf" data-t="${t}" data-i="${i}">✕</button></div>`));
  $("#f_list").innerHTML=out.join("");
}
$("#f_list").onclick=e=>{const b=e.target.closest(".rmf");if(!b)return;files[b.dataset.t].splice(+b.dataset.i,1);sv("iptv_files",files);renderFiles()};
$("#f_in").onchange=async e=>{
  const f=e.target.files[0];if(!f)return;
  const txt=await f.text();
  if(!/#EXT/.test(txt)){alert("Este arquivo não parece uma lista M3U/M3U8.");e.target.value="";return}
  files[$("#f_tab").value].push({name:f.name,text:txt});sv("iptv_files",files);e.target.value="";renderFiles();
};
