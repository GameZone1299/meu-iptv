/* Barra de progresso: clique para pular, arraste para navegar */
let seeking=false;
const seekFrom=e=>{
  if(!v.duration)return;
  const bar=$("#progressBar"),rect=bar.getBoundingClientRect();
  const p=Math.max(0,Math.min(1,(e.clientX-rect.left)/rect.width));
  v.currentTime=p*v.duration;
  $("#progressFill").style.width=(p*100)+"%";$("#progressThumb").style.left=(p*100)+"%";
};
$("#progressBar").onmousedown=e=>{if(!v.duration)return;seeking=true;seekFrom(e);e.preventDefault()};
document.addEventListener("mousemove",e=>{if(seeking)seekFrom(e)});
document.addEventListener("mouseup",()=>{seeking=false});
$("#progressBar").onclick=seekFrom;
/* Preview (thumbnail) ao passar o mouse na barra */
const tipCanvas=$("#tipCanvas"),tipCtx=tipCanvas&&tipCanvas.getContext("2d");
$("#progressBar").onmousemove=e=>{
  const tip=$("#ctrlTip"),bar=$("#progressBar");
  if(!v.duration||!settings.showPreview){tip.style.display="none";return}
  const rect=bar.getBoundingClientRect();
  const p=Math.max(0,Math.min(1,(e.clientX-rect.left)/rect.width));
  const secs=p*v.duration;
  tip.style.display="flex";
  const x=Math.max(90,Math.min(rect.width-90,e.clientX-rect.left));
  tip.style.left=x+"px";
  $("#tipTime").textContent=formatTime(secs);
  if(tipCtx&&v.readyState>=2){
    try{tipCtx.drawImage(v,0,0,tipCanvas.width,tipCanvas.height)}catch(err){tip.style.display="none"}
  }
};
$("#progressBar").onmouseleave=()=>{$("#ctrlTip").style.display="none"};
function formatTime(s){if(!isFinite(s))return"0:00";s=Math.max(0,Math.floor(s));const h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=s%60;
  return h?h+":"+(m<10?"0":"")+m+":"+(sec<10?"0":"")+sec:m+":"+(sec<10?"0":"")+sec}

