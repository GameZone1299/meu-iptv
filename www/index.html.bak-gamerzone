async function startMultiStream(it,i){
  const wrap=document.querySelector(`#multi .mp[data-i="${i}"]`);
  if(!wrap)return;
  const v=wrap.querySelector("video");
  const entry={it,video:v,hls:null,ts:null};
  multi[i]=entry;
  let url=it.url;
  try{if(it.ia)url=await iaUrl(it.ia)}catch(e){return}
  const isTs=/\.ts(\?|$)/i.test(url),isFile=/\.(mp4|mkv|webm|ogv|mov|m4v)(\?|$)/i.test(url),isHls=/\.m3u8(\?|$)/i.test(url);
  try{
    if(isTs&&window.mpegts){
      const p=mpegts.createPlayer({type:"mpegts",isLive:true,url},{enableWorker:false,lazyLoad:false,autoCleanupSourceBuffer:true});
      p.attachMediaElement(v);p.load();p.play().catch(()=>{});entry.ts=p;
    }else if((isHls||(!isFile&&!isTs))&&window.Hls&&Hls.isSupported()){
      const h=new Hls({enableWorker:false,backBufferLength:30,maxBufferLength:30});
      h.loadSource(url);h.attachMedia(v);v.play().catch(()=>{});entry.hls=h;
    }else{v.src=url;v.play().catch(()=>{})}
  }catch(e){}
}
function setMultiAudio(i){
  multiAudio=i;
  multiPlayers().forEach((v,n)=>{v.muted=n!==i});
  $$("#multi .ma").forEach(b=>b.classList.toggle("on",+b.dataset.a===i));
}
function closeMulti(){
  multi.forEach(m=>{try{m.hls&&m.hls.destroy()}catch(e){}try{m.ts&&m.ts.destroy()}catch(e){}});
  multi=[];
  $("#multi").classList.add("hide");$("#multi").innerHTML="";
  $("#multiBar").classList.add("hide");
}
$("#mClose").onclick=()=>closeMulti();
$("#mAdd").onclick=()=>{
  const pool=[...data.live.filter(i=>fav.has(i.url)),...recent.filter(i=>i.t==="live"),...data.live];
  const next=pool.find(x=>!multi.some(m=>m&&m.it.url===x.url));
  if(!next)return alert("Não encontrei outro canal para adicionar.");
  if(multi.length>=4)return alert("Máximo de 4 canais na multi-tela.");
  const list=[...multi.filter(Boolean).map(m=>m.it),next];
  multiOpen(list);
};
$("#multi").onclick=e=>{
  const a=e.target.closest(".ma");if(a){setMultiAudio(+a.dataset.a);return}
  const x=e.target.closest(".mx");
  if(x){
    const rest=multi.filter((m,i)=>m&&i!==+x.dataset.x).map(m=>m.it);
    if(rest.length>=2)multiOpen(rest);else closeMulti();
  }
};
function openMulti(){
  const pool=[...data.live.filter(i=>fav.has(i.url)).slice(0,2),...recent.filter(i=>i.t==="live").slice(0,2),...data.live.slice(0,2)];
  const uniq=[];
  for(const x of pool)if(x&&!uniq.some(y=>y.url===x.url))uniq.push(x);
  if(uniq.length<2)return alert("Precisa de pelo menos 2 canais na lista para usar a multi-tela.");
  multiOpen(uniq.slice(0,2));
}

/* Modo cinema: tela limpa, sem interface ao redor */
function toggleCinema(on){
  const b=document.body;
  const next=on===undefined?!b.classList.contains("cinema"):on;
  b.classList.toggle("cinema",next);
  $("#cinemaBtn").textContent=next?"✕":"🎬";
  if(next){if(!$("#pvbox").classList.contains("full"))setFull(true)}
  else if($("#pvbox").classList.contains("full"))setFull(false);
  showControls();
}

async function togglePip(){
  if(!settings.pip){alert("Picture-in-Picture está desativado. Ative nas configurações avançadas.");return}
  const v=$("#v");
  try{
    if(document.pictureInPictureElement){await document.exitPictureInPicture()}
    else if(v.requestPictureInPicture){await v.requestPictureInPicture()}
  }catch(e){alert("Picture-in-Picture não disponível: "+e.message)}
}

document.addEventListener("click",e=>{
  const t=e.target;
  const tile=t.closest(".tile[data-s]");if(tile){goto(tile.dataset.s);const f=$(".sc.on");f&&f.focus();return}
  const tab=t.closest(".tab");if(tab){goto(tab.dataset.s);return}
  const rc=t.closest(".rc");if(rc){const it=recent[rc.dataset.i];goto(it.t);play(it);return}
  const cc=t.closest(".cc");
  if(cc){const it=ALL().find(i=>i.url===cc.dataset.u)||recent.find(i=>i.url===cc.dataset.u);if(it)play(it);return}
  const sc=t.closest(".sc");if(sc){cat[scr]=sideCats[+sc.dataset.i];limit=LIM;renderSide();renderList();const n=$(`.sc[data-i="${sc.dataset.i}"]`);n&&n.focus();return}
  const row=t.closest(".row");
  if(row){
    const it=view[row.dataset.n];
    if(t.closest(".epg-btn")){openEpg(it);return}
    if(t.closest(".fav")){fav.has(it.url)?fav.delete(it.url):fav.add(it.url);sv("iptv_fav",[...fav]);t.closest(".fav").classList.toggle("on");if(scr==="favs"){renderSide();renderList()}}
    else play(it);return}
  if(t.id==="more"){limit+=LIM;renderList()}
});

/* Grade de programação de um canal */
function openEpg(it){
  const list=epgFor(it);
  $("#epgTitle").textContent=it.name;
  const box=$("#epgGrid");
  if(!list||!list.length){box.innerHTML='<div style="color:var(--mut);padding:14px">Sem dados de EPG para este canal. Configure as URLs do EPG em ⚙️ → 📅 EPG.</div>';$("#epgModal").classList.remove("hide");return}
  const t=Date.now();
  const progs=list.filter(p=>settings.epgShowPast||p.stop>t);
  box.innerHTML=progs.map(p=>{
    const cur=p.start<=t&&p.stop>t;
    return `<div class="prog${cur?" cur":""}">${cur?'<span class="tag">AGORA</span>':""}<time>${fmtProgTime(p.start)}</time><div class="pi"><b>${esc(p.title||"—")}</b>${p.desc?`<small>${esc(p.desc)}</small>`:""}</div></div>`
  }).join("")||'<div style="color:var(--mut);padding:14px">Nenhum programa encontrado.</div>';
  $("#epgModal").classList.remove("hide");
  const curEl=box.querySelector(".prog.cur");if(curEl)curEl.scrollIntoView({block:"center"});
}
