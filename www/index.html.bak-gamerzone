$("#importCfg").onclick=()=>$("#importFile").click();
$("#importFile").onchange=async(e)=>{
  const f=e.target.files[0];if(!f)return;
  try{
    const txt=await f.text(),imp=JSON.parse(txt);
    if(imp.cfg)cfg=imp.cfg;
    if(imp.settings)settings=imp.settings;
    if(imp.files)files=imp.files;
    if(imp.fav)fav=new Set(imp.fav);
    if(imp.recent)recent=imp.recent;
    sv("iptv_cfg",cfg);sv("iptv_settings",settings);sv("iptv_files",files);
    sv("iptv_fav",[...fav]);sv("iptv_recent",recent);
    alert("Configurações importadas com sucesso!");
    $("#cfg").classList.add("hide");await boot();
  }catch(err){alert("Erro ao importar: "+err.message)}
  e.target.value="";
};

$("#resetCfg").onclick=()=>{
