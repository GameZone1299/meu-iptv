<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const arr=v=>Array.isArray(v)?v:(v?[v]:[]);
const sv=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}};
const T={live:"TV ao Vivo",movies:"Filmes",series:"Séries",favs:"Favoritos",recent:"Recentes",search:"Busca"},LIM=200;
/* Catálogo gratuito e legal: Internet Archive (domínio público) */
const IA={movies:"collection:feature_films AND mediatype:movies",series:"collection:classic_tv AND mediatype:movies"};
let useIA=true;try{useIA=localStorage.getItem("iptv_ia")!=="0"}catch(e){}
async function loadIA(t){
  const u="https://archive.org/advancedsearch.php?q="+encodeURIComponent(IA[t])+"&fl[]=identifier&fl[]=title&fl[]=year&sort[]=downloads+desc&rows=400&output=json";
  const r=await fetch(u);if(!r.ok)throw new Error("HTTP "+r.status);
  const docs=(await r.json()).response.docs||[];
  return docs.map(d=>{const y=parseInt(d.year);
    return{name:Array.isArray(d.title)?d.title[0]:(d.title||d.identifier),logo:"https://archive.org/services/img/"+d.identifier,
      group:y?"Anos "+Math.floor(y/10)*10:"Sem data",ia:d.identifier,url:"ia:"+d.identifier}});
}
async function iaUrl(id){
  const r=await fetch("https://archive.org/metadata/"+id);if(!r.ok)throw new Error("HTTP "+r.status);
  const fs=((await r.json()).files||[]).filter(f=>/\.mp4$/i.test(f.name));
  const f=fs.find(f=>f.format==="h.264")||fs.find(f=>f.format==="MPEG4")||fs[0];
  if(!f)throw new Error("sem mp4");
  return "https://archive.org/download/"+id+"/"+f.name.split("/").map(encodeURIComponent).join("/");
}
let cfg={live:["https://iptv-org.github.io/iptv/countries/br.m3u"],movies:[],series:[]};
let settings={
  bufferSize:30,hwAccel:true,autoReconnect:true,reconnectInterval:12,lowLatency:false,defaultVolume:100,
  controlsTimeout:5,showChannelNum:true,showPreview:true,rememberPosition:true,audioLang:"pt",subtitleLang:"pt",
  timeout:15,userAgent:"",referer:"",headers:"",useProxy:false,proxyUrl:"",
  epgUrls:[],epgAutoUpdate:true,epgUpdateInterval:12,epgDays:3,epgShowPast:false,showEpg:true,
  parentalControl:false,parentalPin:"",catchup:false,catchupDays:24,pip:false,autoRefresh:false
};
let fav=new Set(),recent=[],data={live:[],movies:[],series:[]},scr="home",cat={},limit=LIM,view=[],sideCats=[],hls=null,errs=[];
let sortBy="name-asc",filterQuality="",advFilter={};
let viewStats={};try{viewStats=JSON.parse(localStorage.getItem("iptv_stats")||"{}")}catch(e){}
try{const s=JSON.parse(localStorage.getItem("iptv_cfg")||"{}");for(const k in s)if(k in cfg)cfg[k]=arr(s[k])}catch(e){}
try{const s=JSON.parse(localStorage.getItem("iptv_settings")||"{}");Object.assign(settings,s)}catch(e){}
try{fav=new Set(JSON.parse(localStorage.getItem("iptv_fav")||"[]"))}catch(e){}
try{recent=JSON.parse(localStorage.getItem("iptv_recent")||"[]")}catch(e){}
let files={live:[],movies:[],series:[]};
try{const f=JSON.parse(localStorage.getItem("iptv_files")||"{}");for(const k in files)files[k]=arr(f[k])}catch(e){}

function parseM3U(txt){
  const out=[];let cur=null;
  for(const raw of txt.split(/\r?\n/)){
    const l=raw.trim();
    if(l.startsWith("#EXTINF")){
      const a=k=>(l.match(new RegExp(k+'="([^"]*)"'))||[])[1]||"";
      cur={name:a("tvg-name")||l.split(",").pop().trim(),logo:a("tvg-logo"),group:(a("group-title").split(";")[0]||"").trim()||"Sem categoria",id:a("tvg-id")};
    }else if(l&&!l.startsWith("#")&&cur){cur.url=l;out.push(cur);cur=null}
  }
  return out;
}
/* Aceita lista de canais (.m3u/.m3u8) OU um link .m3u8 direto de um único stream (HLS) */
function parseSource(u,txt){
  if(/#EXT-X-(STREAM-INF|TARGETDURATION|MEDIA-SEQUENCE)/.test(txt)){
    let n=u.split("?")[0].split("/").filter(Boolean);n=(n.length>1?n[n.length-2]:n[0]||"Stream")+"";
    return[{name:decodeURIComponent(n),logo:"",group:"Links diretos",url:u}];
  }
  return parseM3U(txt);
}
async function load(t){
  const urls=cfg[t]||[];
  const res=await Promise.allSettled(urls.map(async u=>{const r=await fetch(u);if(!r.ok)throw new Error("HTTP "+r.status);return parseSource(u,await r.text())}));
  const seen=new Set(),all=[];
  res.forEach((r,i)=>{
    if(r.status==="fulfilled"){for(const it of r.value)if(!seen.has(it.url)){seen.add(it.url);all.push(it)}}
    else errs.push(urls[i]+" → "+r.reason.message);
  });
  for(const f of files[t]||[])for(const it of parseSource(f.name,f.text))if(!seen.has(it.url)){seen.add(it.url);all.push(it)}
  if(useIA&&IA[t]){try{for(const it of await loadIA(t))if(!seen.has(it.url)){seen.add(it.url);all.push(it)}}catch(e){errs.push("Internet Archive ("+t+") → "+e.message)}}
  all.forEach((it,i)=>{it.num=i+1;it.t=t});
  data[t]=all;
}

/* ================= EPG (guia de programação) ================= */
let epg={byId:{},byName:{},updated:0};
const epgKey=s=>String(s||"").toLowerCase().replace(/[^a-z0-9]/g,"");
function parseXmltv(xml){
  const out=[],doc=new DOMParser().parseFromString(xml,"text/xml");
  if(doc.querySelector("parsererror"))throw new Error("XML inválido");
  const t=s=>{
    const m=String(s).match(/^(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})/);if(!m)return NaN;
    let ms=Date.UTC(+m[1],+m[2]-1,+m[3],+m[4],+m[5]);
    const off=(String(s).match(/ ([+-]\d{4})/)||[])[1];
    if(off){const sign=off[0]==="-"?-1:1;ms-=sign*(parseInt(off.slice(1,3),10)*60+parseInt(off.slice(3,5),10))*60000}
    return ms};
  doc.querySelectorAll("programme").forEach(p=>{
    const ch=p.getAttribute("channel"),st=p.getAttribute("start"),en=p.getAttribute("stop");
    if(!ch||!st)return;
    const a=t(st),b=en?t(en):a+3600000;
    if(!isFinite(a))return;
    const title=p.querySelector("title"),desc=p.querySelector("desc"),catEl=p.querySelector("category");
    out.push({ch,start:a,stop:isFinite(b)?b:a+3600000,title:title?title.textContent.trim():"",desc:desc?desc.textContent.trim():"",cat:catEl?catEl.textContent.trim():""});
  });
  return out;
}
function buildEpgIndex(list){
  const byId={},byName={};
  for(const p of list){
    (byId[p.ch]=byId[p.ch]||[]).push(p);
    (byName[epgKey(p.ch)]=byName[epgKey(p.ch)]||[]).push(p);
  }
  const sort=o=>{for(const k in o)o[k].sort((a,b)=>a.start-b.start);return o};
  return{byId:sort(byId),byName:sort(byName)};
}
function epgFor(it){
  if(!it)return null;
  const tryKeys=arr=>arr&&arr.length?arr:null;
  return tryKeys(it.id&&epg.byId[it.id])
      || tryKeys(epg.byName[epgKey(it.id)])
      || tryKeys(epg.byName[epgKey(it.name)]);
}
function nowNext(it){
  const list=epgFor(it);if(!list)return null;
  const t=Date.now();let now=null,next=null;
  for(const p of list){
    if(p.start<=t&&p.stop>t){now=p;continue}
    if(p.start>t){next=p;break}
  }
  return now?{now,next}:null;
}
const fmtProgTime=ms=>new Date(ms).toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"});
async function loadEpg(){
  const urls=settings.epgUrls||[];
  if(!urls.length){
    /* Sem URLs configuradas: aproveita o cache (ex.: dados importados) */
    try{const c=JSON.parse(localStorage.getItem("iptv_epgdata")||"null");if(c&&c.byId)epg=c}catch(e){}
    return;
  }
  try{const c=JSON.parse(localStorage.getItem("iptv_epgdata")||"null");if(c&&c.byId)epg=c}catch(e){}
  const last=parseInt(localStorage.getItem("iptv_epgtime")||"0");
  const maxAge=(settings.epgUpdateInterval||12)*3600*1000;
  if(Date.now()-last<maxAge&&Object.keys(epg.byId||{}).length)return;
  const all=[];
  const res=await Promise.allSettled(urls.map(async u=>{
    const r=await fetch(u);if(!r.ok)throw new Error("HTTP "+r.status);
    return parseXmltv(await r.text());
  }));
  res.forEach((r,i)=>{if(r.status==="fulfilled")all.push(...r.value);else errs.push("EPG "+urls[i]+" → "+r.reason.message)});
  if(!all.length)return;
  const days=settings.epgDays||3,cut=Date.now()+days*86400000;
  const idx=buildEpgIndex(all.filter(p=>p.stop>Date.now()-3600000&&p.start<cut));
  epg={...idx,updated:Date.now()};
  sv("iptv_epgdata",epg);sv("iptv_epgtime",Date.now());
  if(scr!=="home")renderList();
}
async function boot(){
  errs=[];$("#u_ia").checked=useIA;renderFiles();
  for(const t of["live","movies","series"])$("#u_"+t).value=(cfg[t]||[]).join("\n");
  $("#err").textContent="Carregando listas...";
  await Promise.all(["live","movies","series"].map(load));
  $("#v").volume=settings.defaultVolume/100;
  loadEpg();
  if(settings.epgAutoUpdate&&settings.epgUrls&&settings.epgUrls.length){
    clearInterval(window._epgTimer);
    window._epgTimer=setInterval(loadEpg,(settings.epgUpdateInterval||12)*3600*1000);
  }
  $("#err").textContent=errs.length?"Alguns links falharam (o servidor precisa permitir CORS):\n"+errs.join("\n"):"";

  /* Atualização automática de playlists */
  if(settings.autoRefresh){
    const lastUpdate=parseInt(localStorage.getItem("iptv_lastUpdate")||"0");
    const now=Date.now();
    if(now-lastUpdate>24*60*60*1000){
      localStorage.setItem("iptv_lastUpdate",now.toString());
      console.log("Playlists atualizadas automaticamente");
    }
    clearInterval(window._autoRefreshInterval);
    window._autoRefreshInterval=setInterval(async()=>{
      console.log("Auto-refresh: recarregando playlists...");
      await Promise.all(["live","movies","series"].map(load));
      localStorage.setItem("iptv_lastUpdate",Date.now().toString());
      if(scr!=="home"){renderSide();renderList()}
    },24*60*60*1000);
  }

  goto(scr);
}
const ALL=()=>["live","movies","series"].flatMap(t=>data[t]);
const baseList=s=>s==="favs"?ALL().filter(i=>fav.has(i.url)):s==="recent"?recent:s==="search"?ALL():data[s];

