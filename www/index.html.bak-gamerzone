}
function setFull(on){
  const b=$("#pvbox");b.classList.toggle("full",on);
  /* controles nativos só aparecem em tela cheia quando o overlay não está disponível */
  $("#v").controls=false;
  if(on&&b.requestFullscreen)b.requestFullscreen().catch(()=>{});
  if(!on&&document.fullscreenElement)document.exitFullscreen().catch(()=>{});
  on?showControls():$("#controls").classList.remove("show");
}
document.addEventListener("fullscreenchange",()=>{if(!document.fullscreenElement&&$("#pvbox").classList.contains("full")){$("#pvbox").classList.remove("full")}});
$("#pvbox").onclick=e=>{
  const t=e.target;
  if(t.id==="xf"){setFull(false);return}
  if(t.id==="pipBtn"||t.closest("#pipBtn")){e.stopPropagation();togglePip();return}
  if(t.id==="cinemaBtn"||t.closest("#cinemaBtn")){e.stopPropagation();toggleCinema();return}
  if(t.closest("#controls"))return;
  if(!$("#pvbox").classList.contains("full")){if($("#v").src||hls)setFull(true);return}
  /* em tela cheia: clique alterna controles quando o vídeo está tocando */
  if($("#v").paused)$("#v").play().catch(()=>{});
  else if($("#controls").classList.contains("show"))$("#v").pause();
  else showControls();
};

